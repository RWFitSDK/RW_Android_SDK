                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:id="@+id/bt_set_screen_sleepmode"
                        android:text="Set screen sleep mode"/>
                </LinearLayout>


                <LinearLayout
